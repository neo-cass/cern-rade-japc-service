{
  "title": "RADE JAPC pods",
  "uid": "rade-japc-pods",
  "schemaVersion": 39,
  "description": "Pod state and container resources for the japc deployments, from the PaaS metrics data source.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/PaaS/",
        "label": "Datasource"
      },
      {
        "name": "deployment",
        "type": "custom",
        "label": "Deployment",
        "multi": true,
        "includeAll": true,
        "allValue": "(japc|japc-master)",
        "query": "japc,japc-master",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "japc",
            "value": "japc",
            "selected": false
          },
          {
            "text": "japc-master",
            "value": "japc-master",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pod running",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Running",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Not running",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (kube_pod_status_phase{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", phase=\"Running\"})",
          "legendFormat": "{{pod}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Container ready",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Ready",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Not ready",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (kube_pod_container_status_ready{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\"})",
          "legendFormat": "{{pod}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Last termination reason",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, reason) (kube_pod_container_status_last_terminated_reason{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\"} == 1)",
          "legendFormat": "{{pod}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Restarts",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Waiting reason",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod, reason) (kube_pod_container_status_waiting_reason{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\"} == 1)",
          "legendFormat": "{{pod}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory against limit",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\"})",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\", resource=\"memory\"})",
          "legendFormat": "{{pod}} limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU against limit",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\"}[5m]))",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\", container=\"japc\", resource=\"cpu\"})",
          "legendFormat": "{{pod}} limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\"}[5m]))",
          "legendFormat": "in {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{pod=~\"$deployment-[0-9a-z]+-[0-9a-z]+\"}[5m]))",
          "legendFormat": "out {{pod}}"
        }
      ]
    }
  ]
}
