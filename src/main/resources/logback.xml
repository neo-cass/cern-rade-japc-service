<!--&lt;!&ndash;        </encoder>&ndash;&gt;-->
<!--        <encoder class="net.logstash.logback.encoder.LogstashEncoder" />-->
<!--    </appender>-->


    <root level="info" >
        <appender-ref ref="RootTraceFileAppender" />
        <appender-ref ref="Console" />
<!--        <appender-ref ref="LogstashAppender" />-->
    </root>


</configuration>

