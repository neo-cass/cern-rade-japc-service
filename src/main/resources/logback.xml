<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="true">

    <property name="LOGS" value="logs" />
    <property name="PATTERN" value="%white(%date{ISO8601}) %highlight(%-5level) [Thread: %yellow(%thread)] [Class: %green(%class{0})]: %message%n%red(%exception)" />
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${PATTERN}</pattern>
        </encoder>

    </appender>

    <appender name="RootTraceFileAppender"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/trace.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${PATTERN}</Pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/trace-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="logstash" class="net.logstash.logback.appender.LogstashUdpSocketAppender">
        <destination>udp://localhost:5000</destination> <!-- Change to your Logstash server address and port -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>version</version>
                <message>message</message>
            </fieldNames>
        </encoder>
    </appender>

    <appender name="LogstashAppender"
              class="net.logstash.logback.appender.LogstashUdpSocketAppender">
        <remoteHost>localhost</remoteHost>
        <port>30050</port>
<!--        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">-->
<!--            <Pattern>${PATTERN}</Pattern>-->
<!--        </encoder>-->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder" />
    </appender>


    <root level="info" >
        <appender-ref ref="RootTraceFileAppender" />
        <appender-ref ref="Console" />
        <appender-ref ref="logstash" />
    </root>


</configuration>